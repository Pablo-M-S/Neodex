	$(MAKE) $(MAKESILENT) -f CMakeFiles/neodex_gui.dir/build.make CMakeFiles/neodex_gui.dir/external/imgui_backends/imgui_impl_sdl2.cpp.o
.PHONY : external/imgui_backends/imgui_impl_sdl2.cpp.o

external/imgui_backends/imgui_impl_sdl2.i: external/imgui_backends/imgui_impl_sdl2.cpp.i
.PHONY : external/imgui_backends/imgui_impl_sdl2.i

